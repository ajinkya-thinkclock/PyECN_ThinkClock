{
  "name": "pyecn-electron",
  "private": true,
  "version": "0.1.0",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently \"npm --prefix ../web run dev\" \"wait-on http://127.0.0.1:5173\" \"cross-env ELECTRON_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm --prefix ../web run build && electron-builder",
    "start": "electron ."
  },
  "devDependencies": {
    "concurrently": "8.2.2",
    "cross-env": "7.0.3",
    "electron": "30.0.8",
    "electron-builder": "24.13.3",
    "wait-on": "7.2.0"
  },
  "build": {
    "appId": "com.pyecn.live",
    "productName": "PyECN Live",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../pyecn",
        "to": "pyecn"
      }
    ]
  }
}
